<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.app_passageiro">

    <!-- ✅ PERMISSÕES DE LOCALIZAÇÃO -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 🔥 NECESSÁRIO PARA GEOLOCALIZAÇÃO EM ANDROID 10+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 🌐 OBRIGATÓRIO PARA GOOGLE MAPS -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="app_passageiro"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <!-- ✅ GOOGLE MAPS API KEY - CONFIGURE COM SUA CHAVE! -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyA9pgt0x8o6lgF3oKxx4u5gRk2otw9pWJ8" />

        <!-- 🚫 DESATIVA IMPELLER (IMPORTANTE PARA MOTO G22) -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- 🎨 TEMA NORMAL APÓS SPLASH -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ⚙️ EMBEDDING V2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- 🔍 QUERIES (ANDROID 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>