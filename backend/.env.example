# Environment
NODE_ENV=production

# Server
PORT=3000
HOST=0.0.0.0

# Mode: real
APP_MODE=real

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/voudemoto
REDIS_URL=redis://localhost:6379

# External Services
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Logging
LOG_LEVEL=info

# Auth
JWT_SECRET=change_me
JWT_ISSUER=voudemoto
JWT_AUDIENCE=voudemoto-admin
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin seed
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_me
ADMIN_SEED_ROLE=SUPER_ADMIN

# Timeouts (ms)
DRIVER_ACCEPT_TIMEOUT=30000
MATCHING_TIMEOUT=60000
RIDE_INACTIVITY_TIMEOUT=300000

# Matching Config
MAX_SEARCH_RADIUS_KM=10
MIN_DRIVERS_FOR_MATCHING=1

# Realtime
REALTIME_REPLAY_TTL_SECONDS=60
